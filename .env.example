# Copia este archivo como .env y completa los valores.
# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si la dejas vacía, se crea sola en instance/secret_key.
SECRET_KEY=

# --- Solo en el servidor (PythonAnywhere) ---
# Cookie de sesión solo por HTTPS
SESSION_COOKIE_SECURE=1
# La app está detrás del proxy de PythonAnywhere (usa la IP real del visitante)
DETRAS_DE_PROXY=1

# --- Bot de WhatsApp (Twilio Sandbox) ---------------------------------------
# Sin TWILIO_AUTH_TOKEN el webhook /whatsapp/webhook responde 503 y solo funciona
# el simulador interno. Los valores están en https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Frase del sandbox que ven los clientes en la guía (Twilio → Sandbox settings), p. ej. join silver-tiger
WHATSAPP_CODIGO_UNION=
# 1 para enviar avisos salientes (cotización lista) por WhatsApp
WHATSAPP_AVISOS=0

# --- Correo (Gmail) para los códigos de recuperación de contraseña ---------------
# Requiere verificación en dos pasos y una "contraseña de aplicación" de Google:
# https://myaccount.google.com/apppasswords  (NO uses la contraseña normal de Gmail)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMITENTE=Arte y Color
